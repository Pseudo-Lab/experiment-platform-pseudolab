# Backend environment variables
# Copy this file to .env and fill in the values.

# --- Cloudflare D1 ---
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# 실험 플랫폼 DB (pseudolab-exp)
D1_DATABASE_ID=your-d1-database-id

# Discord/GitHub 데이터 DB (pseudolab-main) — dashboard 엔드포인트에서 사용
D1_MAIN_DATABASE_ID=your-d1-main-database-id

# Local/sandbox-only forced responses for experiment placement QA
EXPERIMENT_PLACEMENT_SCENARIO_OVERRIDE_ENABLED=false

# --- Cloudflare R2 ---
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_SESSION_TOKEN=your-r2-session-token
R2_BUCKET_NAME=your-r2-bucket-name

# --- Admin Auth ---
# Generate ADMIN_PASSWORD_HASH with:
#   cd backend && python -m scripts.hash_admin_password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2_sha256$260000$replace-with-generated-salt$replace-with-generated-hash
AUTH_SESSION_SECRET=replace-with-random-32-byte-secret
AUTH_SESSION_TTL_SECONDS=43200
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Admin requests require same origin or an exact origin in BACKEND_CORS_ORIGINS.
# Wildcard allows existing SDK CORS only; it does not authorize admin origins.
# Missing admin settings deny management APIs with 503. HTTPS: AUTH_COOKIE_SECURE=true.

# --- Optional Google OIDC public signup (installation-specific) ---
# Keep empty to disable Google sign-in. HTTPS and AUTH_COOKIE_SECURE=true required.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Register this exact callback on a Web application client in Google Cloud.
# Example only; replace the host with the installation's real HTTPS origin.
GOOGLE_OAUTH_REDIRECT_URI=https://platform.example.com/api/v1/auth/google/callback
